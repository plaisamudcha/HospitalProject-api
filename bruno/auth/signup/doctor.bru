meta {
  name: HospitalApi - Auth - Signup (Doctor)
}

env {
  baseUrl = "http://localhost:3000"
}

### Sign Up Doctor (requires ADMIN)
POST {{baseUrl}}/auth/signup/doctor
Content-Type: application/json
Authorization: Bearer {{adminAccessToken}}

{
  "firstName": "Test",
  "lastName": "Doctor",
  "email": "test.doctor@example.com",
  "password": "password1",
  "confirmPassword": "password1",
  "specialization": "GENERAL_PRACTICE"
}

# Notes:
# - `specialization` must match `DoctorType` enum values (see Prisma schema), e.g., GENERAL_PRACTICE, CARDIOLOGY.
# - You must provide an `adminAccessToken` (set in environment) because this route requires ADMIN role.
