meta {
  name: signinPatient
  type: http
  seq: 3
}

post {
  url: {{BASE_URL}}/api/auth/signin
  body: json
  auth: inherit
}

body:json {
  {
    "email": "patient@hotmail.com",
    "password": "123456"
    
  }
}

script:post-response {
    const body = res.getBody();
    const accessToken = body?.data?.accessToken;
    
    if (accessToken) {
      bru.setEnvVar("token", accessToken);
    }
}

settings {
  encodeUrl: true
  timeout: 0
}
