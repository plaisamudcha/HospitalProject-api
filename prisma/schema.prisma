generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum RoleType {
  ADMIN
  DOCTOR
  PATIENT
}

enum Gender {
  MALE
  FEMALE
}

enum DoctorType {
  ANESTHESIOLOGY
  CARDIOLOGY
  DERMATOLOGY
  EMERGENCY_MEDICINE
  ENT
  GENERAL_PRACTICE
  INTERNAL_MEDICINE
  NEUROLOGY
  OBSTETRICS_AND_GYNECOLOGY
  ONCOLOGY
  ORTHOPEDICS
  PEDIATRICS
  PSYCHIATRY
  RADIOLOGY
  SURGERY
  UROLOGY
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MedicineForm {
  CAPSULE
  TABLET
  SYRUP
  INJECTION
  CREAM
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  MOBILE_PAYMENT
  PROMPTPAY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  email        String    @unique
  password     String
  role         RoleType  @default(PATIENT)
  isActive     Boolean   @default(true)
  profileImage String?
  deletedAt    DateTime? @updatedAt
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient       Patient?
  doctor        Doctor?
  refreshTokens RefreshToken[]

  @@index([role])
}

//////////////////////////////////////////////////////
// PATIENT
//////////////////////////////////////////////////////

model Patient {
  id     String   @id @default(uuid())
  dob    DateTime
  gender Gender
  phone  String

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointments Appointment[]
}

//////////////////////////////////////////////////////
// DOCTOR
//////////////////////////////////////////////////////

model Doctor {
  id             String     @id @default(uuid())
  specialization DoctorType

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointments Appointment[]
}

//////////////////////////////////////////////////////
// APPOINTMENT
//////////////////////////////////////////////////////

model Appointment {
  id         String            @id @default(uuid())
  scheduleAt DateTime
  status     AppointmentStatus @default(SCHEDULED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id])
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  medicalRecord MedicalRecord?
  invoice       Invoice?

  @@unique([doctorId, scheduleAt]) // prevent double booking
  @@index([patientId])
  @@index([scheduleAt])
}

//////////////////////////////////////////////////////
// MEDICAL RECORD
//////////////////////////////////////////////////////

model MedicalRecord {
  id        String   @id @default(uuid())
  diagnosis String
  notes     String
  createdAt DateTime @default(now())

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  prescriptions Prescription[]
}

//////////////////////////////////////////////////////
// PRESCRIPTION
//////////////////////////////////////////////////////

model Prescription {
  id       String @id @default(uuid())
  dosage   String
  duration String
  quantity Int

  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  @@index([medicalRecordId])
}

//////////////////////////////////////////////////////
// MEDICINE
//////////////////////////////////////////////////////

model Medicine {
  id           String       @id @default(uuid())
  name         String
  description  String
  form         MedicineForm
  stock        Int          @default(0)
  pricePerUnit Decimal      @db.Decimal(10, 2)

  prescriptions Prescription[]
  stockLogs     PharmacyStockLog[]
}

//////////////////////////////////////////////////////
// STOCK LOG
//////////////////////////////////////////////////////

model PharmacyStockLog {
  id        String   @id @default(uuid())
  change    Int
  reason    String
  createdAt DateTime @default(now())

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  @@index([medicineId])
}

//////////////////////////////////////////////////////
// INVOICE
//////////////////////////////////////////////////////

model Invoice {
  id          String        @id @default(uuid())
  totalAmount Decimal       @db.Decimal(10, 2)
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime?
  paidAt      DateTime?

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  payments Payment[]
}

//////////////////////////////////////////////////////
// PAYMENT (transaction log)
//////////////////////////////////////////////////////

model Payment {
  id            String         @id @default(uuid())
  amount        Decimal        @db.Decimal(10, 2)
  status        PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  createdAt     DateTime       @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

//////////////////////////////////////////////////////
// REFRESH TOKEN
//////////////////////////////////////////////////////

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
