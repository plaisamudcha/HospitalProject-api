generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum RoleType {
  ADMIN
  DOCTOR
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DoctorType {
  ANESTHESIOLOGY
  CARDIOLOGY
  DERMATOLOGY
  EMERGENCY_MEDICINE
  ENT
  GENERAL_PRACTICE
  INTERNAL_MEDICINE
  NEUROLOGY
  OBSTETRICS_AND_GYNECOLOGY
  ONCOLOGY
  ORTHOPEDICS
  PEDIATRICS
  PSYCHIATRY
  RADIOLOGY
  SURGERY
  UROLOGY
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MedicineForm {
  CAPSULE
  TABLET
  SYRUP
  INJECTION
  CREAM
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  MOBILE_PAYMENT
  PROMPTPAY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  role      RoleType @default(PATIENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient       Patient?
  doctor        Doctor?
  refreshTokens RefreshToken[]

  @@index([role])
}

//////////////////////////////////////////////////////
// PATIENT
//////////////////////////////////////////////////////

model Patient {
  id     Int      @id @default(autoincrement())
  dob    DateTime
  gender Gender
  phone  String

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointments Appointment[]
}

//////////////////////////////////////////////////////
// DOCTOR
//////////////////////////////////////////////////////

model Doctor {
  id             Int        @id @default(autoincrement())
  specialization DoctorType

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointments Appointment[]
}

//////////////////////////////////////////////////////
// APPOINTMENT
//////////////////////////////////////////////////////

model Appointment {
  id         Int               @id @default(autoincrement())
  scheduleAt DateTime
  status     AppointmentStatus @default(SCHEDULED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  doctorId  Int
  doctor    Doctor  @relation(fields: [doctorId], references: [id])
  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  medicalRecord MedicalRecord?
  invoice       Invoice?

  @@unique([doctorId, scheduleAt]) // prevent double booking
  @@index([patientId])
  @@index([scheduleAt])
}

//////////////////////////////////////////////////////
// MEDICAL RECORD
//////////////////////////////////////////////////////

model MedicalRecord {
  id        Int      @id @default(autoincrement())
  diagnosis String
  notes     String
  createdAt DateTime @default(now())

  appointmentId Int         @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  prescriptions Prescription[]
}

//////////////////////////////////////////////////////
// PRESCRIPTION
//////////////////////////////////////////////////////

model Prescription {
  id        Int      @id @default(autoincrement())
  dosage    String
  duration  String
  quantity  Int

  unitPrice  Decimal @db.Decimal(10,2)
  totalPrice Decimal @db.Decimal(10,2)

  medicalRecordId Int
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  medicineId Int
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  @@index([medicalRecordId])
}

//////////////////////////////////////////////////////
// MEDICINE
//////////////////////////////////////////////////////

model Medicine {
  id           Int      @id @default(autoincrement())
  name         String
  description  String
  form         MedicineForm
  stock        Int      @default(0)
  pricePerUnit Decimal  @db.Decimal(10,2)

  prescriptions Prescription[]
  stockLogs     PharmacyStockLog[]
}

//////////////////////////////////////////////////////
// STOCK LOG
//////////////////////////////////////////////////////

model PharmacyStockLog {
  id        Int      @id @default(autoincrement())
  change    Int
  reason    String
  createdAt DateTime @default(now())

  medicineId Int
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  @@index([medicineId])
}

//////////////////////////////////////////////////////
// INVOICE
//////////////////////////////////////////////////////

model Invoice {
  id          Int           @id @default(autoincrement())
  totalAmount Decimal       @db.Decimal(10,2)
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime?
  paidAt      DateTime?

  appointmentId Int         @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  payments Payment[]
}

//////////////////////////////////////////////////////
// PAYMENT (transaction log)
//////////////////////////////////////////////////////

model Payment {
  id            Int           @id @default(autoincrement())
  amount        Decimal       @db.Decimal(10,2)
  status        PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  invoiceId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

//////////////////////////////////////////////////////
// REFRESH TOKEN
//////////////////////////////////////////////////////

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}